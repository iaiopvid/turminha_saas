  actor             Membership             @relation(fields: [tenantId, actorMembershipId], references: [tenantId, id], onDelete: Restrict)
  mediaAsset        MediaAsset?            @relation(fields: [mediaAssetId], references: [id])
  mediaAssetId      String?                @db.VarChar(30)

