}

model Invitation {
  id                    String              @id @default(cuid()) @db.VarChar(30)
  tenantId              String              @db.VarChar(30)
  createdByMembershipId String              @db.VarChar(30)
  studentId             String?             @db.VarChar(30)
  classroomId           String?             @db.VarChar(30)
  sourceKey             String?             @db.VarChar(140)
  email                 String              @db.VarChar(254)
  displayName           String              @db.VarChar(100)
  role                  MembershipRole
  tokenHash             String              @unique @db.Char(64)
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime            @default(now())
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy             Membership          @relation("InvitationCreator", fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  student               Student?            @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  classroom             Classroom?          @relation(fields: [tenantId, classroomId], references: [tenantId, id], onDelete: Restrict)
  emailVerifications    EmailVerification[]

  @@unique([tenantId, id])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, email, acceptedAt, revokedAt, expiresAt])
  @@map("invitations")
}

