# Obrigatória: conexão privada do MariaDB 10.10.7/InnoDB deste ambiente. Nunca use uma URL pública de frontend.
# O servidor do projeto é MariaDB 10.10.7/InnoDB; `mysql://` é o protocolo esperado pelo Prisma adapter.
DATABASE_URL="mysql://turminha:troque-esta-senha@127.0.0.1:3306/turminha_saas_dev"
APP_BASE_URL="https://app.example.com"

# Obrigatória fora de development: segredo aleatório de sessão, mínimo de 32 bytes.
SESSION_SECRET="gere-um-segredo-aleatorio-com-no-minimo-32-bytes"

# Obrigatória em produção para HMAC das chaves de rate limit (mínimo 32 caracteres).
RATE_LIMIT_SECRET="gere-outro-segredo-aleatorio-com-no-minimo-32-bytes"

# Opcional: habilite apenas no ambiente local/teste para seed de demonstração.
DEMO_SEED="false"
# Necessária somente para criar contas fictícias em development/test; defina uma senha local forte.
DEMO_SEED_PASSWORD=""

# PRIVATE_STORAGE_DRIVER: auto prefere S3 e cai para disco local se não estiver configurado/indisponível;
# local força disco local; s3 exige endpoint S3 configurado. Não use uma pasta pública para armazenamento local.
PRIVATE_STORAGE_DRIVER="auto"
PRIVATE_STORAGE_LOCAL_DIR="private-storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
CLAMAV_HOST=""
CLAMAV_PORT="3310"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Turminha <no-reply@example.com>"
REDIS_URL=""
OPENAI_API_KEY=""
ASAAS_API_KEY=""
ASAAS_BASE_URL=""
