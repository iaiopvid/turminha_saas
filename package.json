{
  "name": "turminha-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma scripts next.config.ts prisma.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:local:create": "tsx scripts/create-local-database.ts",
    "db:migrate": "prisma migrate dev --name init_shared_tenant_core",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "storage:init": "tsx scripts/init-storage.ts",
    "storage:drain": "node --conditions=react-server --import tsx scripts/drain-storage-outbox.ts",
    "db:inspect": "tsx scripts/inspect-database.ts",
    "verify:m1": "tsx scripts/verify-m1.ts",
    "smoke:m1": "tsx scripts/smoke-m1.ts",
    "smoke:m2": "tsx scripts/smoke-m2.ts",
    "smoke:m2:lifecycle": "tsx scripts/smoke-m2-lifecycle.ts",
    "smoke:m2:email": "tsx scripts/smoke-m2-email.ts",
    "smoke:m3:evidence": "node --conditions=react-server --import tsx scripts/smoke-m3-evidence.ts",
    "smoke:m3:workflows": "node --conditions=react-server --import tsx scripts/smoke-m3-workflows.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@fontsource-variable/fredoka": "5.3.0",
