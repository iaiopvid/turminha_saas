    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lru-cache": "11.5.3",
    "lucide-react": "^0.468.0",
    "mariadb": "^3.4.5",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
